---
import '../styles/global.css';
interface Props { title: string; description?: string; ogTitle?: string; ogDescription?: string; }
const { title, description = 'WIRON is the brand that builds it all — WIRON Websites, WIRON Tools, WIRON Cloud & WIRON Games. One WIRON brand, every surface. SEO-ready, fast, human-centered.', ogTitle = title, ogDescription = description } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <title>{title}</title>
  </head>
  <body>
    <header class="topnav">
      <div class="container topnav-inner">
        <a href="/" class="logo"><span class="logo-mark">W</span> WIRON</a>
        <nav aria-label="Primary">
          <a href="#services">Services</a>
          <a href="#solutions">Solutions</a>
          <a href="#work">Work</a>
          <a href="#seo">SEO & Perf</a>
          <a href="#pricing">Pricing</a>
          <a href="#contact">Contact</a>
        </nav>
        <div class="nav-cta">
          <a href="#contact" class="btn btn-secondary btn-sm">Talk to WIRON</a>
          <a href="#pricing" class="btn btn-primary btn-sm">Start a project</a>
          <button class="hamburger" id="menuBtn" aria-label="Open menu">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          </button>
        </div>
      </div>
    </header>

    <div class="drawer" id="drawer">
      <div class="drawer-bg" id="drawerBg"></div>
      <div class="drawer-panel">
        <div class="row-between"><span class="logo"><span class="logo-mark">W</span> WIRON</span><button class="btn btn-secondary btn-sm" id="drawerClose">Close</button></div>
        <nav>
          <a href="#services">Services</a>
          <a href="#solutions">Solutions</a>
          <a href="#work">Work</a>
          <a href="#seo">SEO & Perf</a>
          <a href="#pricing">Pricing</a>
          <a href="#contact">Contact</a>
        </nav>
        <div style="margin-top:auto;display:grid;gap:10px">
          <a href="/contact" class="btn btn-primary" style="width:100%">Start a project</a>
          <p class="meta" style="text-align:center">hello@wiron.studio · Response in ~2h</p>
        </div>
      </div>
    </div>

    <main><slot /></main>

    <footer class="pagefoot">
      <div class="container">
        <div style="display:grid;grid-template-columns:1.3fr 1fr 1fr 1fr;gap:28px">
          <div>
            <div class="logo" style="font-size:18px"><span class="logo-mark">W</span> WIRON</div>
            <p class="meta" style="margin-top:10px;line-height:1.6;max-width:30ch">The brand that provides all services — websites, tools, cloud, games. One team, one backlog, continuous growth.</p>
            <div style="margin-top:14px;display:flex;gap:8px"><span class="tag">© 2026 WIRON</span><span class="tag">wiron.studio</span></div>
          </div>
          <div>
            <p style="font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--fg)">Services</p>
            <div style="margin-top:10px;display:grid;gap:6px;font-size:13px;color:var(--muted)"><a href="/services">Websites</a><a href="/services">Tools</a><a href="/services">Cloud</a><a href="/services">Games</a></div>
          </div>
          <div>
            <p style="font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--fg)">Resources</p>
            <div style="margin-top:10px;display:grid;gap:6px;font-size:13px;color:var(--muted)"><a href="#knowledge">Guides</a><a href="#knowledge">Changelog</a><a href="/seo-performance">SEO handbook</a><a href="#faq">FAQ</a></div>
          </div>
          <div>
            <p style="font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--fg)">SEO</p>
            <p class="meta" style="margin-top:10px;line-height:1.6">Sitemap · robots.txt · Schema.org · Open Graph · hreflang · RSS — all generated per publish. Crawlable, fast, indexable by default.</p>
          </div>
        </div>
        <hr class="rule" style="margin:28px 0 18px"/>
        <div class="row-between" style="flex-wrap:wrap">
          <span class="meta">Built for clarity, speed and discoverability. No templates, no lock-in.</span>
          <span class="meta">Privacy · Terms · <a href="mailto:hello@wiron.studio" style="text-decoration:underline">hello@wiron.studio</a></span>
        </div>
      </div>
    </footer>
  <script is:inline>
    const d=document.getElementById('drawer');
    document.getElementById('menuBtn')?.addEventListener('click',()=>d.classList.add('open'));
    document.getElementById('drawerClose')?.addEventListener('click',()=>d.classList.remove('open'));
    document.getElementById('drawerBg')?.addEventListener('click',()=>d.classList.remove('open'));
    d?.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>d.classList.remove('open')));
    </script>
  </body>
</html>
