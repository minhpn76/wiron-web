<script is:inline>
// service tabs
document.querySelectorAll('.svc-tab').forEach(btn=>{
  btn.addEventListener('click',()=>{
    document.querySelectorAll('.svc-tab').forEach(b=>{b.classList.remove('active');b.setAttribute('aria-selected','false')});
    btn.classList.add('active');btn.setAttribute('aria-selected','true');
    document.querySelectorAll('.svc-panel').forEach(p=>p.classList.remove('active'));
    document.getElementById('panel-'+btn.dataset.tab).classList.add('active');
  });
});

// billing toggle
const billM=document.getElementById('billMonthly'), billY=document.getElementById('billYearly');
function setBilling(mode){
  const yearly = mode==='yearly';
  billY.style.background = yearly?'var(--fg)':'transparent';
  billY.style.color = yearly?'var(--surface)':'var(--muted)';
  billM.style.background = yearly?'transparent':'var(--fg)';
  billM.style.color = yearly?'var(--muted)':'var(--surface)';
  document.querySelectorAll('.price').forEach(el=>{
    el.textContent = yearly? el.dataset.yearly : el.dataset.monthly;
  });
}
billM.addEventListener('click',()=>setBilling('monthly'));
billY.addEventListener('click',()=>setBilling('yearly'));

// faq accordion
document.querySelectorAll('.faq-item').forEach(item=>{
  item.querySelector('.faq-q').addEventListener('click',()=>{
    const wasOpen=item.classList.contains('open');
    document.querySelectorAll('.faq-item').forEach(i=>i.classList.remove('open'));
    if(!wasOpen) item.classList.add('open');
  });
});

// site search (client-side filter over knowledge + scroll to services)
const searchInput=document.getElementById('siteSearch');
const logList=document.getElementById('logList');
const hint=document.getElementById('searchHint');
const noRes=document.getElementById('noResults');
function doSearch(q){
  q=q.trim().toLowerCase();
  if(!q){
    logList.querySelectorAll('.log-row').forEach(r=>r.style.display='');
    noRes.style.display='none';
    hint.textContent='Try: website speed, cloud migration, tool automation, multiplayer';
    return;
  }
  let visible=0;
  logList.querySelectorAll('.log-row').forEach(r=>{
    const hay=(r.textContent+' '+(r.dataset.keywords||'')).toLowerCase();
    const show=hay.includes(q);
    r.style.display=show?'':'none';
    if(show) visible++;
  });
  noRes.style.display=visible?'none':'block';
  hint.textContent=visible? visible+' result'+(visible>1?'s':'')+' · press Enter to jump to knowledge' : 'No matches — try a different term';
  // highlight services if query matches branch
  if(['website','tool','cloud','game'].some(k=>q.includes(k))){
    document.getElementById('services').scrollIntoView({behavior:'smooth',block:'start'});
  }
}
let t;
searchInput.addEventListener('input',e=>{
  clearTimeout(t); t=setTimeout(()=>doSearch(e.target.value),180);
});
searchInput.addEventListener('keydown',e=>{
  if(e.key==='Enter'){
    e.preventDefault();
    const q=searchInput.value.trim().toLowerCase();
    if(q) document.getElementById('knowledge').scrollIntoView({behavior:'smooth'});
  }
});

// contact form
document.getElementById('contactForm').addEventListener('submit',e=>{
  e.preventDefault();
  const name=document.getElementById('name').value.trim();
  const email=document.getElementById('email').value.trim();
  const msg=document.getElementById('msg').value.trim();
  const consent=document.getElementById('consent').checked;
  const status=document.getElementById('formStatus');
  if(!name || !email || !msg){ status.style.display='block'; status.textContent='Please fill name, email and your problem.'; status.style.background='oklch(96% 0.04 25)'; status.style.color='oklch(55% 0.2 25)'; return; }
  if(!consent){ status.style.display='block'; status.textContent='Please confirm you agree to be contacted.'; status.style.background='oklch(96% 0.04 25)'; status.style.color='oklch(55% 0.2 25)'; return; }
  if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)){ status.style.display='block'; status.textContent='Please enter a valid work email.'; status.style.background='oklch(96% 0.04 25)'; status.style.color='oklch(55% 0.2 25)'; return; }
  status.style.display='block';
  status.style.background='var(--accent-soft)'; status.style.color='var(--accent)';
  status.textContent='Thanks, '+name.split(' ')[0]+' — we\'ll reply within ~2 hours with next steps for your '+ (document.querySelector('input[name="branch"]:checked')?.value || 'project')+' branch.';
  e.target.reset();
});
</script>
</BaseLayout>
