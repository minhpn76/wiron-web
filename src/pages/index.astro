---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="WIRON \u2014 The Brand for Websites, Tools, Cloud & Games | One Brand, Every Service"
  description="WIRON is the brand that builds it all \u2014 WIRON Websites, WIRON Tools, WIRON Cloud & WIRON Games. One WIRON brand, every surface. SEO-ready, fast, human-centered."
>


<!-- HERO -->
<section id="hero" class="section hero">
  <div class="container hero-split">
    <div>
      <p class="eyebrow">WIRON — The Brand That Builds Everything</p>
      <h1>One brand for your website, tools, cloud and games.</h1>
      <p class="lead" style="margin-top:16px">Customers don't come for a homepage. They come with a problem. WIRON solves it end-to-end — from a site that ranks, to tools that remove friction, to cloud that stays up, to play that keeps them coming back.</p>
      <div class="hero-cta" style="margin-top:22px">
        <a href="#services" class="btn btn-primary">Explore WIRON services</a>
        <a href="#work" class="btn btn-secondary">See live work →</a>
      </div>
      <div class="trust-row">
        <span class="tag"><span class="dot"></span> SEO-native from day one</span>
        <span class="tag"><span class="dot" style="background:oklch(68% 0.16 145)"></span> Core Web Vitals ≥ 95</span>
        <span class="tag">GDPR · SOC 2 ready</span>
      </div>
      <div class="seo-badges">
        <span class="meta" style="display:flex;gap:6px;align-items:center"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 2l7 4v6c0 5-3.5 7.5-7 8-3.5-.5-7-3-7-8V6l7-4z"/></svg> Schema.org + Open Graph auto-generated</span>
        <span class="meta">·</span>
        <span class="meta">Sitemap & robots.txt managed</span>
      </div>

      <!-- site search (SEO demo) -->
      <div class="search-wrap" role="search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
        <input id="siteSearch" type="search" placeholder="Search WIRON: e.g. 'headless checkout' or 'game hosting'…" aria-label="Search WIRON services"/>
      </div>
      <p class="meta" id="searchHint" style="margin-top:8px;text-align:center">Try: website speed, cloud migration, tool automation, multiplayer</p>
    </div>

    <div class="mock" aria-label="WIRON dashboard mock">
      <div class="mock-bar"><span class="mock-dot"></span><span class="mock-dot"></span><span class="mock-dot"></span><span class="mock-title">wiron.studio / WIRON — Live</span><span class="pill" style="margin-left:auto">All systems operational</span></div>
      <div class="mock-body">
        <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px">
          <span class="pill" style="background:color-mix(in oklch, var(--accent) 14%, white);color:var(--accent)">Websites</span>
          <span class="tag">Tools</span><span class="tag">Cloud</span><span class="tag">Games</span>
        </div>
        <div class="grid-2" style="gap:10px">
          <div class="card" style="padding:16px">
            <p class="meta" style="font-size:11px;letter-spacing:.06em;text-transform:uppercase">Organic traffic</p>
            <div class="row" style="align-items:baseline;gap:8px;margin-top:6px"><span class="num" style="font-size:26px;font-weight:700;letter-spacing:-.03em">+214%</span><span class="pill" style="font-size:10px;padding:2px 8px">90 days</span></div>
            <div class="bar-track"><div class="bar-fill" style="width:78%"></div></div>
            <p class="meta" style="margin-top:8px">After WIRON SEO rebuild · Lighthouse 99</p>
          </div>
          <div class="card" style="padding:16px">
            <p class="meta" style="font-size:11px;letter-spacing:.06em;text-transform:uppercase">Infra cost</p>
            <div class="row" style="align-items:baseline;gap:8px;margin-top:6px"><span class="num" style="font-size:26px;font-weight:700;letter-spacing:-.03em">−43%</span><span class="tag" style="font-size:11px">Cloud tuned</span></div>
            <div class="bar-track"><div class="bar-fill" style="width:44%;background:oklch(68% 0.16 145)"></div></div>
            <p class="meta" style="margin-top:8px">Same traffic, smaller bill</p>
          </div>
        </div>
        <div class="mini-kpi">
          <div><strong class="num">1.1s</strong><span>LCP · p75</span></div>
          <div><strong class="num">0 CLS</strong><span>Layout stable</span></div>
          <div><strong class="num">42ms</strong><span>Edge TTFB</span></div>
        </div>
        <div style="margin-top:14px;display:flex;gap:8px">
          <span class="tag" style="background:var(--accent);color:white;border-color:var(--accent)">wiron.studio/docs/seo</span>
          <span class="meta">↗ Crawlable, indexable, fast — by default.</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- SERVICES OVERVIEW -->
<section id="services" class="section">
  <div class="container stack" style="gap:28px">
    <div class="row-between" style="align-items:end;flex-wrap:wrap">
      <div style="max-width:56ch">
        <p class="eyebrow">Four services. One root system.</p>
        <h2>Pick a problem. We already have the service for it.</h2>
        <p class="lead" style="margin-top:12px;font-size:16px">No handoffs between agencies. WIRON keeps strategy, design, engineering and growth in one place — so the site you launch is the system that scales.</p>
      </div>
      <p class="meta" style="max-width:28ch;text-align:right">Every engagement starts with a 45-min diagnostic. You leave with a ranked backlog — even if you don't hire us.</p>
    </div>

    <div class="grid-4">
      <div class="card feature">
        <div class="feature-mark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="4" width="18" height="14" rx="2"/><path d="M8 20h8"/><path d="M12 18v2"/></svg></div>
        <h3>Websites</h3>
        <p>Marketing sites and product sites that rank, convert and stay fast after launch. Headless, composable, editable.</p>
        <div style="margin-top:14px;display:flex;gap:6px;flex-wrap:wrap"><span class="tag">Next.js · Astro</span><span class="tag">Headless CMS</span></div>
      </div>
      <div class="card feature">
        <div class="feature-mark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M14.5 3.5a2.5 2.5 0 013 3L8 16l-4 1 1-4 9.5-9.5z"/><path d="M13 6l5 5"/></svg></div>
        <h3>Tools</h3>
        <p>Internal tools, customer portals and automations that kill busywork. From spreadsheet to system in weeks.</p>
        <div style="margin-top:14px;display:flex;gap:6px;flex-wrap:wrap"><span class="tag">Portals</span><span class="tag">Automations</span></div>
      </div>
      <div class="card feature">
        <div class="feature-mark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M17 18a5 5 0 000-10 6 6 0 00-10 4"/><path d="M3 18h14"/><path d="M7 14l2 2 4-4"/></svg></div>
        <h3>Cloud</h3>
        <p>Resilient, cost-aware cloud — migration, observability and edge. We left "it works on my machine" in 2019.</p>
        <div style="margin-top:14px;display:flex;gap:6px;flex-wrap:wrap"><span class="tag">AWS · GCP</span><span class="tag">Edge</span></div>
      </div>
      <div class="card feature" style="background:var(--fg);color:var(--surface);border-color:var(--fg)">
        <div class="feature-mark" style="background:transparent;border-color:color-mix(in oklch, white 18%, transparent);color:var(--surface)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 11h12M8 7h8M9 15h6M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg></div>
        <h3 style="color:var(--surface)">Games</h3>
        <p style="color:color-mix(in oklch, white 72%, transparent)">Playable brand moments — web games, loyalty quests and interactive launches that people actually share.</p>
        <div style="margin-top:14px;display:flex;gap:6px;flex-wrap:wrap"><span class="tag" style="background:transparent;color:var(--surface);border-color:color-mix(in oklch, white 22%, transparent)">WebGL · Canvas</span><span class="tag" style="background:transparent;color:var(--surface);border-color:color-mix(in oklch, white 22%, transparent)">Multiplayer</span></div>
      </div>
    </div>

    <!-- Interactive service detail -->
    <div class="card" style="padding:22px">
      <div class="svc-tabs" role="tablist" aria-label="Service details">
        <button class="svc-tab active" data-tab="websites" role="tab" aria-selected="true">Websites — Acquire</button>
        <button class="svc-tab" data-tab="tools" role="tab">Tools — Operate</button>
        <button class="svc-tab" data-tab="cloud" role="tab">Cloud — Scale</button>
        <button class="svc-tab" data-tab="games" role="tab">Games — Retain</button>
      </div>

      <div id="panel-websites" class="svc-panel active">
        <div class="svc-grid">
          <div>
            <h3>Websites that earn their keep</h3>
            <p style="color:var(--muted);margin:8px 0 0">Strategy → Content system → Design → Ship → Measure. Pages are structured data first, pixels second — so Google understands them before a human sees them.</p>
            <ul class="check-list">
              <li><i>✓</i> <span><strong style="color:var(--fg)">SEO foundation:</strong> semantic HTML, JSON-LD, sitemap, hreflang, OG/Twitter, canonicals — generated, not hoped for.</span></li>
              <li><i>✓</i> <span><strong style="color:var(--fg)">Editor-friendly:</strong> non-devs ship pages in minutes. Preview, schedule, roll back.</span></li>
              <li><i>✓</i> <span><strong style="color:var(--fg)">Performance budget:</strong> LCP &lt; 1.2s enforced in CI. Regressions block deploy.</span></li>
            </ul>
            <div style="margin-top:16px;display:flex;gap:8px;flex-wrap:wrap"><a href="#contact" class="btn btn-primary btn-sm">Audit my site</a><a href="#seo" class="btn btn-ghost btn-sm btn-arrow">How we handle SEO</a></div>
          </div>
          <div class="card" style="background:var(--bg);padding:18px">
            <p class="meta" style="font-weight:600;color:var(--fg);letter-spacing:.04em;text-transform:uppercase">Deliverables</p>
            <div style="margin-top:12px;display:grid;gap:10px">
              <div class="row" style="justify-content:space-between;padding:10px 12px;background:var(--surface);border:1px solid var(--border);border-radius:10px"><span style="font-size:13px;font-weight:600">Information architecture</span><span class="meta">Week 1</span></div>
              <div class="row" style="justify-content:space-between;padding:10px 12px;background:var(--surface);border:1px solid var(--border);border-radius:10px"><span style="font-size:13px;font-weight:600">Design system + components</span><span class="meta">Week 2–3</span></div>
              <div class="row" style="justify-content:space-between;padding:10px 12px;background:var(--accent);color:white;border:1px solid var(--accent);border-radius:10px"><span style="font-size:13px;font-weight:650">Shipped & indexed</span><span style="font-size:12px;opacity:.9">Week 4</span></div>
            </div>
            <p class="meta" style="margin-top:12px">Typical: 3–5 weeks. You own all code and content.</p>
          </div>
        </div>
      </div>

      <div id="panel-tools" class="svc-panel">
        <div class="svc-grid">
          <div>
            <h3>Tools that remove work</h3>
            <p style="color:var(--muted);margin:8px 0 0">We turn the doc, sheet or inbox you live in into a real product — with permissions, audit log and a UI people want to use.</p>
            <ul class="check-list">
              <li><i>✓</i> <span>Customer portals, admin consoles, approval flows, quoting engines.</span></li>
              <li><i>✓</i> <span>Integrations: Stripe, HubSpot, Notion, Airtable, Postgres — bidirectional.</span></li>
              <li><i>✓</i> <span>Shipped with analytics so you can see what the tool saved.</span></li>
            </ul>
            <div style="margin-top:16px"><a href="#contact" class="btn btn-primary btn-sm">Map my workflow</a></div>
          </div>
          <div class="card" style="background:var(--bg);padding:18px">
            <p class="meta" style="font-weight:600;color:var(--fg)">Example · Quote-to-cash in 11 days</p>
            <p class="meta" style="margin-top:8px">A services firm moved from Sheets + email to a WIRON portal. Quotes went from 2 days → 18 minutes. Errors to zero.</p>
            <div style="margin-top:12px;display:flex;gap:8px;flex-wrap:wrap"><span class="pill">−94% time</span><span class="tag">SOC 2 logged</span></div>
          </div>
        </div>
      </div>

      <div id="panel-cloud" class="svc-panel">
        <div class="svc-grid">
          <div>
            <h3>Cloud you don't have to babysit</h3>
            <p style="color:var(--muted);margin:8px 0 0">Migrate without downtime, observe without noise, pay without surprises. Infra as code, preview envs, edge cache.</p>
            <ul class="check-list">
              <li><i>✓</i> <span>Zero-downtime migration & IaC (Terraform / Pulumi).</span></li>
              <li><i>✓</i> <span>Observability: traces, logs, SLOs — one pane, paged only when it matters.</span></li>
              <li><i>✓</i> <span>FinOps: rightsizing + autoscale + spot — monthly report with savings.</span></li>
            </ul>
          </div>
          <div class="card" style="background:var(--bg);padding:18px">
            <p class="meta" style="font-weight:600;color:var(--fg)">Stack</p>
            <div style="margin-top:10px;display:flex;gap:8px;flex-wrap:wrap"><span class="tag">AWS</span><span class="tag">GCP</span><span class="tag">Cloudflare</span><span class="tag">Vercel Edge</span><span class="tag">Postgres</span><span class="tag">Redis</span></div>
            <p class="meta" style="margin-top:14px">We stay out of religious wars. We pick what fits your traffic and team.</p>
          </div>
        </div>
      </div>

      <div id="panel-games" class="svc-panel">
        <div class="svc-grid">
          <div>
            <h3>Games that make brands memorable</h3>
            <p style="color:var(--muted);margin:8px 0 0">Lightweight web games for launches, loyalty and learning. No app install, runs on any phone, shareable in a link.</p>
            <ul class="check-list">
              <li><i>✓</i> <span>Campaign games, product configurators, training sims.</span></li>
              <li><i>✓</i> <span>Leaderboards, rewards, referrals built in.</span></li>
              <li><i>✓</i> <span>Analytics: completion, share rate, return visits.</span></li>
            </ul>
          </div>
          <div class="card" style="background:var(--bg);padding:18px">
            <p class="meta" style="font-weight:600;color:var(--fg)">Play it</p>
            <div style="margin-top:10px;display:grid;grid-template-columns:repeat(2,1fr);gap:8px">
              <div style="background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:14px;text-align:center"><div style="font-size:22px">🎯</div><p style="margin:6px 0 0;font-size:13px;font-weight:600">Drop Quest</p><p class="meta">Avg. 3:42 play</p></div>
              <div style="background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:14px;text-align:center"><div style="font-size:22px">🧩</div><p style="margin:6px 0 0;font-size:13px;font-weight:600">Config Lab</p><p class="meta">32% → lead</p></div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- SOLUTIONS (problem -> service) -->
<section id="solutions" class="section">
  <div class="container">
    <div style="max-width:56ch;margin-bottom:28px">
      <p class="eyebrow">Solutions — Come with a problem, leave with a plan</p>
      <h2>Your customers are already searching. We make sure they find WIRON.</h2>
      <p class="lead" style="margin-top:10px;font-size:16px">SEO isn't a checkbox. It's how the site is built — content model, URL design, speed, and structured data working together.</p>
    </div>

    <div class="grid-3">
      <div class="card" style="padding:22px">
        <p class="meta" style="color:var(--accent);font-weight:700;letter-spacing:.06em;text-transform:uppercase">Problem → Service</p>
        <h3 style="margin-top:8px">"We rebuilt the site and traffic dropped."</h3>
        <p style="color:var(--muted);font-size:14px;margin-top:8px">Pre-migration audit, redirect map, content parity, and index monitoring. We recover, then grow.</p>
        <div style="margin-top:14px;display:flex;gap:8px;align-items:center"><span class="tag" style="background:var(--fg);color:white;border-color:var(--fg)">Websites</span><span class="meta">→ SEO recovery</span></div>
      </div>
      <div class="card" style="padding:22px">
        <p class="meta" style="color:var(--accent);font-weight:700;letter-spacing:.06em;text-transform:uppercase">Problem → Service</p>
        <h3 style="margin-top:8px">"Sales lives in spreadsheets."</h3>
        <p style="color:var(--muted);font-size:14px;margin-top:8px">We ship a portal in 2–3 weeks. Same data, real permissions, searchable, auditable.</p>
        <div style="margin-top:14px;display:flex;gap:8px;align-items:center"><span class="tag" style="background:var(--fg);color:white;border-color:var(--fg)">Tools</span><span class="meta">→ Portal</span></div>
      </div>
      <div class="card" style="padding:22px">
        <p class="meta" style="color:var(--accent);font-weight:700;letter-spacing:.06em;text-transform:uppercase">Problem → Service</p>
        <h3 style="margin-top:8px">"We pay more as we grow."</h3>
        <p style="color:var(--muted);font-size:14px;margin-top:8px">FinOps pass + autoscale. Most teams cut 25–45% without touching product code.</p>
        <div style="margin-top:14px;display:flex;gap:8px;align-items:center"><span class="tag" style="background:var(--fg);color:white;border-color:var(--fg)">Cloud</span><span class="meta">→ Cost tune</span></div>
      </div>
      <div class="card" style="padding:22px">
        <p class="meta" style="color:var(--accent);font-weight:700;letter-spacing:.06em;text-transform:uppercase">Problem → Service</p>
        <h3 style="margin-top:8px">"Our launch got no buzz."</h3>
        <p style="color:var(--muted);font-size:14px;margin-top:8px">Launch with a playable moment. People share a score, not a press release.</p>
        <div style="margin-top:14px;display:flex;gap:8px;align-items:center"><span class="tag" style="background:var(--fg);color:white;border-color:var(--fg)">Games</span><span class="meta">→ Launch game</span></div>
      </div>
      <div class="card" style="padding:22px">
        <p class="meta" style="color:var(--accent);font-weight:700;letter-spacing:.06em;text-transform:uppercase">Problem → Service</p>
        <h3 style="margin-top:8px">"We have the content, not the traffic."</h3>
        <p style="color:var(--muted);font-size:14px;margin-top:8px">Topic clusters, internal linking, and programmatic pages — built into the CMS, not bolted on.</p>
        <div style="margin-top:14px;display:flex;gap:8px;align-items:center"><span class="tag" style="background:var(--fg);color:white;border-color:var(--fg)">Websites</span><span class="meta">→ SEO system</span></div>
      </div>
      <div class="card" style="padding:22px;border:1.5px dashed var(--border);background:transparent">
        <h3>Tell us yours</h3>
        <p style="color:var(--muted);font-size:14px;margin-top:8px">In 45 minutes we map your pain to the right service — and tell you if you don't need us at all.</p>
        <a href="#contact" class="btn btn-secondary btn-sm" style="margin-top:14px">Book diagnostic — free</a>
      </div>
    </div>
  </div>
</section>

<!-- SEO & PERFORMANCE DEEP DIVE -->
<section id="seo" class="section">
  <div class="container grid-1-2">
    <div>
      <p class="eyebrow">SEO, built in — not bolted on</p>
      <h2>Google-ready by construction</h2>
      <p class="lead" style="margin-top:10px;font-size:16px">Every WIRON surface ships with the SEO plumbing already wired — so your team publishes, and search does the rest.</p>
      <div style="margin-top:22px;display:grid;gap:14px">
        <div class="row" style="align-items:start;gap:12px">
          <span style="width:28px;height:28px;border-radius:50%;background:var(--accent);color:white;display:grid;place-items:center;flex:0 0 28px;font-size:12px;font-weight:800">1</span>
          <div><strong style="font-size:14px">Semantic & structured</strong><p class="meta" style="margin:4px 0 0;line-height:1.5">Clean HTML5, JSON-LD (Organization, Product, FAQ, Breadcrumb), canonical & hreflang, sitemap.xml + robots.txt auto-updated on publish.</p></div>
        </div>
        <div class="row" style="align-items:start;gap:12px">
          <span style="width:28px;height:28px;border-radius:50%;background:var(--accent);color:white;display:grid;place-items:center;flex:0 0 28px;font-size:12px;font-weight:800">2</span>
          <div><strong style="font-size:14px">Speed is ranking</strong><p class="meta" style="margin:4px 0 0;line-height:1.5">Image optimization, edge cache, font subsetting, and a CI performance budget — builds fail if LCP regresses.</p></div>
        </div>
        <div class="row" style="align-items:start;gap:12px">
          <span style="width:28px;height:28px;border-radius:50%;background:var(--accent);color:white;display:grid;place-items:center;flex:0 0 28px;font-size:12px;font-weight:800">3</span>
          <div><strong style="font-size:14px">Content that compounds</strong><p class="meta" style="margin:4px 0 0;line-height:1.5">Topic clusters, programmatic SEO, and internal linking generated from your content model — not manual cross-links.</p></div>
        </div>
      </div>
      <div style="margin-top:18px;display:flex;gap:8px;flex-wrap:wrap"><span class="tag">Core Web Vitals</span><span class="tag">Schema.org</span><span class="tag">Open Graph</span><span class="tag">sitemap.xml</span><span class="tag">hreflang</span></div>
    </div>
    <div class="card" style="padding:20px">
      <div class="row-between" style="margin-bottom:14px"><p class="meta" style="font-weight:700;color:var(--fg);letter-spacing:.05em;text-transform:uppercase">SEO health — sample audit</p><span class="pill">Live check</span></div>
      <div style="display:grid;gap:10px">
        <div class="row" style="justify-content:space-between;padding:12px 14px;background:var(--bg);border:1px solid var(--border);border-radius:12px"><span style="font-size:13px;font-weight:600">Lighthouse SEO</span><span style="display:flex;align-items:center;gap:8px"><span class="num" style="font-weight:800;color:oklch(64% 0.16 145)">100</span><span style="width:72px;height:6px;background:var(--border);border-radius:999px;overflow:hidden"></span></span></div>
        <div class="row" style="justify-content:space-between;padding:12px 14px;background:var(--bg);border:1px solid var(--border);border-radius:12px"><span style="font-size:13px;font-weight:600">Performance</span><span style="display:flex;align-items:center;gap:8px"><span class="num" style="font-weight:800">98</span><span style="width:72px;height:6px;background:var(--border);border-radius:999px;overflow:hidden"></span></span></div>
        <div class="row" style="justify-content:space-between;padding:12px 14px;background:var(--bg);border:1px solid var(--border);border-radius:12px"><span style="font-size:13px;font-weight:600">Accessibility</span><span style="display:flex;align-items:center;gap:8px"><span class="num" style="font-weight:800">99</span><span style="width:72px;height:6px;background:var(--border);border-radius:999px;overflow:hidden"></span></span></div>
